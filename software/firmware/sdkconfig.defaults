CONFIG_LWIP_STATS=y

CONFIG_SDK_TOOLCHAIN_SUPPORTS_TIME_WIDE_64_BITS=y

# Reduce bootloader log verbosity
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# Increase main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# Enable filesystem
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable FreeRTOS stats formatting functions, needed for 'tasks' command
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#
# BT config
#
# Bluetooth is disabled: the firmware contains no BLE code, keeping the
# controller enabled only wasted flash and RAM.
CONFIG_BT_ENABLED=n

#
# Enable SNMP
#
# CONFIG_LWIP_SNMP_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV6_AUTOCONFIG=y

CONFIG_MBEDTLS_TLS_CLIENT=y
CONFIG_MBEDTLS_TLS_ENABLED=y
CONFIG_MBEDTLS_CMAC_C=y
